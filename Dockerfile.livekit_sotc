# ── SOTC VoiceBot (livekit_sotc/) ────────────────────────────────────────────
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY livekit_sotc/ .

# Pre-download turn-detector model files
RUN python sotc_agent_stt_llm_tts_v1.py download-files

RUN mkdir -p chat_logs/conversations
RUN rm -rf __pycache__ *.pyc

EXPOSE 8082

CMD ["python", "sotc_agent_stt_llm_tts_v1.py", "start"]
