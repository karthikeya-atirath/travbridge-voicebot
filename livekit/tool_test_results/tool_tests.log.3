neraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Goa', 'cityCode': 'GOI', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Thiruvananthapuram', 'cityCode': 'TRV', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Patna', 'cityCode': 'PAT', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Visakhapatnam', 'cityCode': 'VTZ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kolkata', 'cityCode': 'CCU', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Mumbai', 'cityCode': 'BOM', 'ltItineraryCode': '', 'holidayLtPricingId': ''}], 'packageItinerary': {'summary': "The 'Lively Lisbon' package is a 4-day tour dedicated entirely to exploring the vibrant city of Lisbon. The itinerary includes visits to iconic landmarks such as the historic Belem Tower, the magnificent Jeronimos Monastery, and the charming, winding streets of the Alfama district. Participants will enjoy riding the famous Tram 28, experiencing an authentic live Fado music performance, and indulging in local culinary delights like the traditional Pastel de Nata.", 'itinerary': [{'day': 1, 'description': '\xa0\nArrive Lisbon\nTransfers: Upon your arrival at the Lisbon airport, you will meet the representative and transferred to the hotel in a private vehicle.\nSpecial Note: Check in will be as per the standard timings of 15:00 hrs or as per hotel discretion.', 'mealDescription': 'N/A', 'overnightStay': 'Hotel\xa0Zenit Lisboa / Vip Executive Saldanha / BE Lisboa / Lisboa Plaza / Lisboa or similar in Lisbon'}, {'day': 2, 'description': '\xa0\nHop On Hop Off Tour\nHop on Hop Off Tour: Explore Lisbon’s limitless compelling sights with the freedom of a hop-on hop-off bus tour, with an optional line to Cascais. Tickets are valid for 24 hours to grant you the most sightseeing flexibility. This tour offers four different lines to choose from (tickets valid for one, two, three or four lines) with stops at Lisbon’s memorable monuments, viewpoints and neighborhoods. You’ll get a lasting taste of Lisbon’s history and culture on any line, so grab a ticket and hop on.', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel\xa0Zenit Lisboa / Vip Executive Saldanha / BE Lisboa / Lisboa Plaza / Lisboa or similar in Lisbon\xa0'}, {'day': 3, 'description': "\xa0\nDay At Leisure (Optional Activities)\nLisbon Essentials in One Day: Sintra, Cascais and Belem (Optional Tour 1): Start in central Lisbon and travel by air-conditioned minivan to Sintra. Visit the stunning Pena Palace, a masterpiece of 19th-century Romanticism, and stroll through its exotic gardens. Learn about King Fernando II, the “King-Artist,” and his eclectic architectural vision. Next, head to Cascais, a former royal summer retreat. Enjoy panoramic views of Guincho and Estoril beaches, then take a guided walk through the historic Cascais Citadel, built over 500 years ago to defend against pirates. Afterward, enjoy 1.5 hours of free time for lunch at local seafood restaurants. End the tour in Belem, famous for its riverside charm and Pasteis de Belem. See the exteriors of the Jeronimos Monastery and Belem Tower, both UNESCO World Heritage Sites. Return to Lisbon with tips from your guide for further exploration.\n[Supplement Cost: EUR 95 per Adult, EUR 80 per Child]\nSkip the Line - Live Fado Show In Lisbon: 'Fado In Chiado' (Optional Tour 2): Fado in Chiado is a live Fado Show, an excellent way to discover culture and the city. Enjoy a 50 minutes performance featuring two singers and two guitarists. Experience this passion in a show that expresses the soul of Lisbon. [Supplement Cost – EUR 30 Per Adult & EUR 25 Per Child]", 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel\xa0Zenit Lisboa / Vip Executive Saldanha / BE Lisboa / Lisboa Plaza / Lisboa or similar in Lisbon'}, {'day': 4, 'description': '\xa0\nDepart Lisbon\xa0\nTransfers: From Lisbon hotel to airport, you will have a private transfer.\nDo spare a few minutes to share your feedback with our representative or via email - as your valued suggestions will be most appreciated. Arrive home with pleasant memories of your overseas tour, which we are sure you will treasure for a lifetime.', 'mealDescription': 'Breakfast', 'overnightStay': 'N/A'}]}, 'hotels': ['\xa0\n\n\n\n\nHotels Envisaged Or Similar\n\n\n\n\nCities\n\n\nStandard category\n\n\n\nMadrid\n\nPetit Palace Cliper Gran Via / Petit Palace Tres Cruces / Hotel Los Condes / Petit Palace Chueca / Hotel Madrid Centro, Affiliated by Melia or similar\n\n\n\n\nSeville\n\n\nHotel Derby Sevilla / Las Casas De Los Mercaderes By Silken / Eurostars Regina / H10 Corregidor Boutique Hotel or similar\n\n\n\nBarcelona\n\nHotel Viladomat By Silken / Catalonia Roma / Leonardo Hotel Barcelona Gran Via / Continental Palacete or similar\xa0\n\n\n\n', '\n\n\n\nHotels Envisaged Or Similar\n\n\n\n\nCity\n\n\nValue category\n\n\n\n\nLisbon\n\n\nZenit Lisboa / Vip Executive Saldanha / BE Hotel Lisboa / Hotel Lisboa Plaza / Hotel Lisboa or similar\xa0\xa0\n\n\n\n'], 'hotels_list': {'0': '\xa0\n\n\n\n\nHotels Envisaged Or Similar\n\n\n\n\nCities\n\n\nStandard category\n\n\n\nMadrid\n\nPetit Palace Cliper Gran Via / Petit Palace Tres Cruces / Hotel Los Condes / Petit Palace Chueca / Hotel Madrid Centro, Affiliated by Melia or similar\n\n\n\n\nSeville\n\n\nHotel Derby Sevilla / Las Casas De Los Mercaderes By Silken / Eurostars Regina / H10 Corregidor Boutique Hotel or similar\n\n\n\nBarcelona\n\nHotel Viladomat By Silken / Catalonia Roma / Leonardo Hotel Barcelona Gran Via / Continental Palacete or similar\xa0\n\n\n\n', '1': '\n\n\n\nHotels Envisaged Or Similar\n\n\n\n\nCity\n\n\nValue category\n\n\n\n\nLisbon\n\n\nZenit Lisboa / Vip Executive Saldanha / BE Hotel Lisboa / Hotel Lisboa Plaza / Hotel Lisboa or similar\xa0\xa0\n\n\n\n'}, 'continents': [{'continentId': 5, 'countryCode': 'PT', 'countryName': 'Portugal', 'continentName': 'Europe'}], 'packageTourType': ['Value'], 'packageTourType_details': [{'category': 'Value', 'price': 60500.0, 'hotels': ['\n\n\n\nHotels Envisaged Or Similar\n\n\n\n\nCity\n\n\nValue category\n\n\n\n\nLisbon\n\n\nZenit Lisboa / Vip Executive Saldanha / BE Hotel Lisboa / Hotel Lisboa Plaza / Hotel Lisboa or similar\xa0\xa0\n\n\n\n']}], 'meals': ['Breakfast Included'], 'visa': [], 'transfer': ['As per itinerary'], 'sightseeing': ['Sightseeing: (For SIC Package tours will operate on seat in coach basis and from a designated point)\n\nLisbon Hop On Hop Off (1 Day)\n', 'Sightseeing: (Tour starts from a city centre point, transportation to & from the hotel is not included)\n\nMadrid Highlights + Royal Palace Skip the Line Guided Tour on shared basis\nSeville Hop on Hop Off (24 Hrs) Ticket\nBarcelona Hop on Hop Off (24 Hrs) Ticket\n'], 'tourManagerDescription': '', 'flightDescription': 'Return Economy Class Airfare', 'inclusions': 'Accommodation:\n\n3 Nights’ accommodation in Lisbon based on the hotel category selected or similar\n\nMeals:\n\nDaily Breakfast *(Except Day 1)\n\nTransportation: [Includes Privates services on Point to Point Basis]\n\nArrival & Departure Airport Transfer from Lisbon to hotel and back to Airport\n\nSightseeing: (For SIC Package tours will operate on seat in coach basis and from a designated point)\n\nLisbon Hop On Hop Off (1 Day)\n\nInsurance:\n\nOverseas Travel Insurance (up to 60 yrs age group only)\n', 'exclusions': '\nInternational air ticket, Domestic ticket if any, Airport taxes & Visa charges.\nLunch & Dinner (if not mentioned)\nDrinks during meals\nTCS and GST is not included in the above cost and will be charged on final amount.\nLaundry, telephone, optional excursions and other items of a personal nature.\nMandatory tipping to Guide/ driver of USD 10 per person per day is not included in the price.\nCity taxes / Resort Fees – To be paid at the hotel.\nCost of foreign exchange for personal use.\nAny items or services not specified in the itinerary ‘INCLUSIONS’ head.\n', 'termsAndConditions': 'Important Note:\n\nThe above price is based on minimum 2 Passengers travelling together.\nThe above price is not valid for travel during Trade Fairs & Events\nMaximum 3 persons (adult / child) are allowed per room.\nMidnight surcharges apply for transfers between 2200 hrs. – 0700 hrs.\nWIFI, Tea / Coffee making facility etc. in the rooms cannot be guaranteed.\xa0\n(Supplement charges may apply for such services)\nStandard check-in time into the hotel is 1500 Hrs.\nMost hotels in Europe are not air-conditioned.\nAt this point of time no services are confirmed and the same is subject to availability\nTCS & GST as applicable on the above tour cost.\n\n\xa0\nTerms and Conditions:\n\nBlack out period will attract surcharges and above rates could differ.\nTCS & GST would be levied as applicable\nThe rates are valid for minimum 02 adults travelling together at all times.\nMaximum 3 persons (2 adult + 1 child or 3 adults) are allowed per room.\nThe rates are not valid on block out dates which covers sporting events, trade fairs , conventions , and major congresses\nSurcharges wherever applicable would be advised at the time of booking.\nTo proceed with the booking you need to pay Non-Refundable Booking deposit depending on the package which will be adjusted towards the cost of the tour.\nShould the period of travel, or the number of participants, or the type of accommodation, or the type of transport or the duration of the trip, change the quote will be adjusted accordingly.\nThe rates are subject to availability of hotel accommodation and sightseeing tours at the time of booking. We reserve the right to use an alternate hotel accommodation of an equal or higher standard. If we source a more expensive alternative, we reserve the right to re-quote based on the higher rates.\nWe are not holding any Hotel blocks for this package.\nInternational Check in time is 1500 hours / Check out time is 1100 hours, early check in and check-out is subject to availability and cannot be guaranteed.\nTransfers wherever included are without night surcharges and from specific airports only.\nNo refunds either in part or in full will be made for any unutilized service.\nAll the sightseeing tours and excursions are organized by local companies and may be from designated points. The timings and days of operation are subject to alteration. Changes if any will be intimated at the time of booking.\nSightseeing’s tours are strictly based on weather conditions and also local service providers have rights to cancel the sightseeing tours without prior notice.\nRates subject to change without prior notice and also for clients travelling during weekends.\nOffer can be withdrawn at any point without prior notice. Bookings once confirmed are subject to cancellation charges which shall be advised at that time.\nAs a practice all international hotels charge a security deposit via credit card or cash, at the time of check- in for each room. The amount will vary according to the hotel and is refunded back to the clients upon check-out. Debit cards should not be offered as it will be charged immediately and refunded only after 2-3 weeks. If any additional services or mini bar or any other service is utilized at the hotel, the hotel reserves the right to charge the same on this security deposit provided by the client. The said organisation would not be responsible for these transactions and these are solely between the hotels and the clients.\nThe organisation will not be responsible for any change in the price due to factors not in the control of the organisation.\n', 'pkgSubtypeId': 4, 'pkgSubtypeName': 'FIT', 'pkgTypeId': 1, 'isFlightIncluded': 'Y', 'holidayPlusSubType': 2, 'productId': 11, 'flightsAvailability': 'This package offers optional flights. You can choose to add flights or book separately.', 'serviceSlots': None, 'constructed_thumbnailImage': 'https://resources.thomascook.in/images/holidays/PKG014518/Lisbon2671.jpg', 'constructed_images': ['https://resources.thomascook.in/images/holidays/PKG014518/itinerary/Lisbon753.jpg', 'https://resources.thomascook.in/images/holidays/PKG014518/itinerary/Lisbon3.jpg', 'https://resources.thomascook.in/images/holidays/PKG014518/itinerary/Lisbon7532.jpg', 'https://resources.thomascook.in/images/holidays/PKG014518/itinerary/Lisbon4.jpg']}, 'score': 1.395028, 'departureCity_details': None, 'fareCalendar': None}, {'id': 'PKG014608', 'itinerary_data': {'packageId': 'PKG014608', 'availableMonths': ['october_2026'], 'packageName': 'Wonderful Greece', 'days': 9, 'cities': [{'cityName': 'Athens', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Athens', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Mykonos', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Mykonos', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Santorini', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Santorini', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Crete', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Crete', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Crete', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}], 'highlights': [''], 'pdfName': 'PKG014608_0_20260903151806', 'price': 172313, 'packageSummary': "The 'Wonderful Greece' package is a 9-day tour covering the beautiful destinations of Crete, Athens, Santorini, and Mykonos. Throughout this island-hopping adventure, participants will immerse themselves in the rich history and vibrant culture of Greece through guided city tours of ancient ruins, scenic ferry rides across the Aegean Sea, and leisure time to explore picturesque volcanic beaches and iconic whitewashed villages.", 'images': ['Athens.jpg', 'AcropolisinAthens.avif', 'AdobeStock_67990916.jpeg', 'Mykons753.jpg', 'Santorini_1.jpeg', 'SunsetonthefamousOiacityGreece.jpeg', 'Crete7531.jpg', 'Knossos753.jpg', 'Athens75354.jpg'], 'minimumPrice': 172313, 'thumbnailImage': 'AdobeStock_67990916.jpeg', 'packageTheme': ['Family'], 'isTcilRecomended': 'Recommended', 'packageData': "Package ID: PKG014608 is named 'Wonderful Greece' and spans 9 days. The itinerary includes:\nDay 1 - Athens, Meals: N/A, Description: Arrive Athens Transfers: Upon arrival you will be met the representative & transferred to the hotel on private basis. Special Note: Please note the standard check in time would be at 14:00 hrs. or subject to hotel discretion, GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 2 - Athens, Meals: Breakfast, Description: Half Day Guided Tour Of Athens On Shared Basis (Sic) Athens Sightseeing :The Acropolis & Acropolis Museum: Step into history on a half day guided tour of Athens. The morning begins at the Panathenaic Stadium, birthplace of the modern Olympic Games, then past the Temple of Olympian Zeus and the elegant Athens Trilogy University, Academy, and National Library. Ascend to the legendary Acropolis to explore the Parthenon, Erechtheion, and Temple of Athena Nike. End your morning at the Acropolis Museum, where ancient treasures are brought to life. [Entrance fees to Acropolis & Museum is included] Special Note: The sightseeing will be on a shared basis and the pick up for the same will be from selected central points., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 3 - Mykonos, Meals: Breakfast, Description: Athens To Mykonos Transfers: Today you will have a private transfer from the hotel to the Port for the ferry to Mykonos. Upon arrival at Mykonos there will be a shared transfer from the port to the Hotel., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 4 - Mykonos, Meals: Breakfast, Description: Day Free At Leisure Mykonos Sightseeing (Optional). Today explore the island on your own. Among the cobbled streets, next to the churches, behind the freshly painted shutters, through the delivery of island living, the heavenly beaches and the liveliness of the night, Mykonos still keeps its secrets: The happiest different moments for everyone, here, on the most famous island in the world, each one of us makes each moment UNIQUE. Mykonos retains full beauty through the passage of time, and is and always will be a perfect host to visitors, offering unlimited vacation and great expectations., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 5 - Santorini, Meals: Breakfast, Description: Mykonos To Santorini Transfers: Today you will have a shared transfer from the hotel to the Port for the ferry to Santorini. Upon arrival at Santorini there will be a shared transfer from the port to the Hotel. Special Note: The check in at the hotel will be as per the standard hotel time. Post check in the rest of the day will be free at leisure., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 6 - Santorini, Meals: Breakfast, Description: Full Day Santorini Panorama Bus Tour Transfers: The sightseeing will be on a shared basis and the pick-up for the same will be from selected central points Full day Santorini panorama bus tour: Today Embark on a mesmerizing journey through Santorini's iconic landscapes and its best kept secrets. As dawn breaks, gather at the heart of the island, ready to unravel Santorinis tales and traditions. Begin with the historic Akrotiri Lighthouse, standing as a beacon since the 19th century. Its grandeur offers breathtaking panoramas of the Aegean’s endless blue. Let the horizon captivate the unique beauty of Perivolos. Here, the striking black sands meet crystal-clear waters in a dance of contrasts, a spectacle to behold and experience firsthand. From the shores, step into the time-capsule village of Megalochori. Stroll through its cobblestoned paths, past preserved bell towers and welcoming squares. The atmosphere is thick with tales from bygone eras, inviting you to get lost in its charm. As you leave its charm, ascend to Profitis Ilias, a vantage point that offers unparalleled views and serenity that words can scarcely describe. This enchantment continues at Panagia Episkopi, Santorini’s oldest preserved church. Marvel at the richness of its Byzantine heritage, a testament to time and faith. As afternoon shades into evening, indulge in the island’s vinicultural legacy. A local winery welcomes you to taste the notes of Santorini’s volcanic soil in every sip. Let stories of grapevines and harvests unfold as the taste of Assyrtiko graces your palate. And just as the day reaches its crescendo, you end the tour at the village of Oia, bathed in golden hues as the sun performs its final act melting into the horizon, GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 7 - Crete, Meals: Breakfast, Description: Santorini To Heraklion (Crete) Transfers: Today you will have a shared transfer from the hotel to the Port for the ferry to Heraklion (Crete). Upon arrival at Heraklion (Crete) there will be a private transfer from the port to the Hotel. Special Note: The check in at the hotel will be as per the standard hotel time. Post check in the rest of the day will be free at leisure., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 8 - Crete, Meals: Breakfast, Description: Day Free At Leisure Heraklio Sightseeing (Optional). Today, the day is yours to spend in order to explore Heraklio (The capital) or experience an optional tour. This city more than lives up to its reputation as being one of the most attractive of the many cities of the Mediterranean! It can satisfy the wishes and demands of a diverse variety of visitors from all over the world, while still providing enjoyment and satisfaction to its permanent residents. It is certainly not a matter of coincidence that it has been the center of Crete for so many centuries, and continues to be so, thanks to an abundance of sightseeing attractions, its joyous way of life, and the legendary hospitality of the Cretan people., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 9 - Crete, Meals: Breakfast, Description: Depart Heraklion Transfers: From Heraklion hotel to the Airport in private transfer. Do spare a few minutes to share your feedback with our representative or via email as your valued suggestions will be most appreciated. Arrive home with pleasant memories of your overseas tour, which we are sure you will treasure for a lifetime., GeoLocation: (Lat: 0.0, Lon: 0.0).\nThe price is 172313.0. Hotels envisaged include: \n\n\n\n\xa0 \xa0 \xa0 STANDARD CATEGORY (3* HOTELS OR SIMILAR)\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nAcropolis Ami or Similar\n\n\nElena Hotel or Similar\n\n\nCosta Marina Hotel or similar\n\n\nLato Boutique Hotel or Similar\n\n\n\n, \n\n\n\nVALUE CATEGORY (4* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nTitania Hotel or similar\n\n\nPetinos Hotel or similar\n\n\nSantorini Palace Hotel or similar\n\n\nOlive Green Hotel or Similar\n\n\n\n, \n\n\n\nPREMIUM CATEGORY (5* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nRoyal Olympic hotel\nor similar\n\n\nPetinos Beach hotel \nor similar\n\n\nMajestic hotel \nor similar\n\n\nGalaxy\xa0Hotel \nor Similar\n\n\n\n. Meals include: \nDaily Breakfast *(Except Day 1)\nHalf Board Meal arrangement as part of Classical Tour\n. Inclusions: Accommodation: 2 Nights’ accommodation in Athens based on the hotel category selected or similar 2 Nights’ accommodation in Mykonos based on the hotel category selected or similar 2 Nights’ accommodation in Santorini based on the hotel category selected or similar 2 Nights’ accommodation in Heraklio (Crete) based on the hotel category selected or similar Meals: Daily Breakfast *(Except Day 1) Transportation: Private Airport Transfer from Athens Airport to Hotel Private transfer from Athens hotel to Port for the ferry to Mykonos Shared transport from Mykonos Port to the hotel and back to port Shared transport from Santorini port to hotel and back to port Private transport from Heraklion Port to the hotel Private Airport transfer from Santorini Hotel to Airport Ferry Tickets: [Cost is subject to vary until Ticketed] Normal Ferry ticket – Economy class from Athens to Mykonos High Speed Ferry ticket - Economy class from Mykonos to Santorini High Speed Ferry ticket - economy class from Santorini to Heraklion Sightseeing: (For SIC Package tours will operate on seat in coach basis & from a designated point) Half-day City tour of Athens with new Acropolis Museum on sharing basis tour coach. Full day Santorini panorama bus tour on sharing basis Insurance: Overseas Travel Insurance (up to 60 yrs age group only). Exclusions: International air ticket, Domestic ticket if any, Airport taxes & Visa charges. Lunch & Dinner (if not mentioned) Drinks during meals TCS and GST is not included in the above cost and will be charged on final amount. Laundry, telephone, optional excursions and other items of a personal nature. Mandatory tipping to Guide/ driver of EUR 10 per person per day is not included City taxes / Resort Fees – To be paid at the hotel. Cost of foreign exchange for personal use. Cost of PCR Test is not included & any medical examination will be treated as actual Any items or services not specified in the itinerary ‘INCLUSIONS’ head.. Product Terms and Conditions: Important Notes: The above price is based on minimum 2 Passengers travelling together. The above price is not valid for travel during Trade Fairs & Events Maximum 3 persons (adult / child) are allowed per room. Midnight surcharges apply for transfers between 2200 hrs. – 0700 hrs. WIFI, Tea / Coffee making facility etc. in the rooms cannot be guaranteed. (Supplement charges may apply for such services) Standard check-in time into the hotel is 1500 Hrs. Most hotels in Europe are not air-conditioned. At this point of time no services are confirmed and the same is subject to availability Terms and Conditions: Travel Validity: 1 April 2026 – 15 October 2026 Black out period will attract surcharges and above rates could differ. The rates are valid for minimum 02 adults travelling together at all times. Maximum 3 persons (2 adult + 1 child or 3 adults) are allowed per room. The rates are not valid on block out dates which covers sporting events, trade fairs, conventions, and major congresses Surcharges wherever applicable would be advised at the time of booking. To proceed with the booking, you need to pay Non-Refundable Booking deposit depending on the package which will be adjusted towards the cost of the tour. Should the period of travel, or the number of participants, or the type of accommodation, or the type of transport or the duration of the trip, change the quote will be adjusted accordingly. The rates are subject to availability of hotel accommodation and sightseeing tours at the time of booking. We reserve the right to use an alternate hotel accommodation of an equal or higher standard. If we source a more expensive alternative, we reserve the right to re-quote based on the higher rates. We are not holding any Hotel blocks for this package. International Check in time is 1500 hours / Check out time is 1100 hours, early check in and check-out is subject to availability and cannot be guaranteed. Transfers wherever included are without night surcharges and from specific airports only. No refunds either in part or in full will be made for any unutilized service. All the sightseeing tours and excursions are organized by local companies and may be from designated points. The timings and days of operation are subject to alteration. Changes if any will be intimated at the time of booking. Sightseeing’s tours are strictly based on weather conditions and also local service providers have rights to cancel the sightseeing tours without prior notice. Rates subject to change without prior notice and also for clients travelling during weekends. Offer can be withdrawn at any point without prior notice. Bookings once confirmed are subject to cancellation charges which shall be advised at that time. As a practice all international hotels charge a security deposit via credit card or cash, at the time of check- in for each room. The amount will vary according to the hotel and is refunded back to the clients upon check-out. Debit cards should not be offered as it will be charged immediately and refunded only after 2-3 weeks. If any additional services or mini bar or any other service is utilized at the hotel, the hotel reserves the right to charge the same on this security deposit provided by the client. The said organisation would not be responsible for these transactions and these are solely between the hotels and the clients. The organisation will not be responsible for any change in the price due to factors not in the control of the organisation.. Highlights of the package: .", 'departureCities': [{'cityName': 'Mumbai', 'cityCode': 'BOM', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Jaipur', 'cityCode': 'JAI', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kochi', 'cityCode': 'COK', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Indore', 'cityCode': 'IDR', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Chandigarh', 'cityCode': 'IXC', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Pune', 'cityCode': 'PNQ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Bhopal', 'cityCode': 'BHO', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kozhikode', 'cityCode': 'CCJ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kolkata', 'cityCode': 'CCU', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Bhubaneswar', 'cityCode': 'BBI', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Thiruvananthapuram', 'cityCode': 'TRV', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Bangalore', 'cityCode': 'BLR', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Patna', 'cityCode': 'PAT', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Chennai', 'cityCode': 'MAA', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Visakhapatnam', 'cityCode': 'VTZ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Varanasi', 'cityCode': 'VNS', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kanpur', 'cityCode': 'KNU', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Hyderabad', 'cityCode': 'HYD', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Jammu', 'cityCode': 'IXJ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Ahmedabad', 'cityCode': 'AMD', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Delhi', 'cityCode': 'DEL', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Goa', 'cityCode': 'GOI', 'ltItineraryCode': '', 'holidayLtPricingId': ''}], 'packageItinerary': {'summary': "The 'Wonderful Greece' package is a 9-day tour covering the beautiful destinations of Crete, Athens, Santorini, and Mykonos. Throughout this island-hopping adventure, participants will immerse themselves in the rich history and vibrant culture of Greece through guided city tours of ancient ruins, scenic ferry rides across the Aegean Sea, and leisure time to explore picturesque volcanic beaches and iconic whitewashed villages.", 'itinerary': [{'day': 1, 'description': '\xa0\nArrive Athens\n\xa0\nTransfers: Upon arrival you will be met the representative & transferred to the hotel on private basis.\n\xa0\nSpecial Note: Please note the standard check in time would be at 14:00 hrs. or subject to hotel discretion', 'mealDescription': 'N/A', 'overnightStay': 'Hotel\xa0Acropolis Ami\xa0(Standard) /\xa0Titania (Value) /\xa0Royal Olympic (Premium) or similar\xa0in Athens'}, {'day': 2, 'description': '\xa0\n\xa0\nHalf Day Guided Tour Of Athens On Shared Basis (Sic)\n\xa0\nAthens Sightseeing\xa0:The Acropolis & Acropolis Museum: Step into history on a half day guided tour of Athens. The morning begins at the Panathenaic Stadium, birthplace of the modern Olympic Games, then past the Temple of Olympian Zeus and the elegant Athens Trilogy University, Academy, and National Library. Ascend to the legendary Acropolis to explore the Parthenon, Erechtheion, and Temple of Athena Nike. End your morning at the Acropolis Museum, where ancient treasures are brought to life. [Entrance fees to Acropolis & Museum is included]\n\xa0\nSpecial Note: The sightseeing will be on a shared basis and the pick up for the same will be from selected central points.', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Acropolis Ami (Standard) / Titania (Value) / Royal Olympic (Premium) or similar in Athens'}, {'day': 3, 'description': '\xa0\nAthens To Mykonos\n\xa0\nTransfers:\xa0\n\nToday you will have a private transfer from the hotel to the Port for the ferry to Mykonos.\nUpon arrival at Mykonos there will be a shared transfer from the port to the Hotel.\n', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Elena (Standard) / Petinos (Value) / (Premium) or similar in Mykonos'}, {'day': 4, 'description': '\xa0\n\xa0\nDay Free At Leisure\xa0\n\xa0\nMykonos Sightseeing (Optional). Today explore the island on your own. Among the cobbled streets, next to the churches, behind the freshly painted shutters, through the delivery of island living, the heavenly beaches and the liveliness of the night, Mykonos still keeps its secrets: The happiest different moments for everyone, here, on the most famous island in the world, each one of us makes each moment UNIQUE. Mykonos retains full beauty through the passage of time, and is and always will be a perfect host to visitors, offering unlimited vacation and great expectations.\xa0', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Elena (Standard) / Petinos (Value) / (Premium) or similar in Mykonos'}, {'day': 5, 'description': '\xa0\n\xa0\nMykonos To Santorini\xa0\n\xa0\nTransfers:\xa0\n\nToday you will have a shared transfer from the hotel to the Port for the ferry to Santorini.\nUpon arrival at Santorini there will be a shared transfer from the port to the Hotel.\n\n\xa0\nSpecial Note:\xa0\n\nThe check in at the hotel will be as per the standard hotel time.\xa0\nPost check in the rest of the day will be free at leisure.\n', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Costa Marina (Standard) / Santorini Palace (Value) / Majestic (Premium) or similar in Santorini'}, {'day': 6, 'description': "\xa0\nFull Day Santorini Panorama Bus Tour\xa0\n\xa0\nTransfers: The sightseeing will be on a shared basis and the pick-up for the same will be from selected central points\n\xa0\nFull day Santorini panorama bus tour: Today Embark on a mesmerizing journey through Santorini's iconic landscapes and its best kept secrets. As dawn breaks, gather at the heart of the island, ready to unravel Santorinis tales and traditions.\xa0\xa0\n\xa0\nBegin with the historic Akrotiri Lighthouse, standing as a beacon since the 19th century. Its grandeur offers breathtaking panoramas of the Aegean’s endless blue. Let the horizon captivate the unique beauty of Perivolos. Here, the striking black sands meet crystal-clear waters in a dance of contrasts, a spectacle to behold and experience firsthand.\xa0 From the shores, step into the time-capsule village of Megalochori. Stroll through its cobblestoned paths, past preserved bell towers and welcoming squares. The atmosphere is thick with tales from bygone eras, inviting you to get lost in its charm. As you leave its charm, ascend to Profitis Ilias, a vantage point that offers unparalleled views and serenity that words can scarcely describe.\xa0\n\xa0\nThis enchantment continues at Panagia Episkopi, Santorini’s oldest preserved church. Marvel at the richness of its Byzantine heritage, a testament to time and faith. As afternoon shades into evening, indulge in the island’s vinicultural legacy. A local winery welcomes you to taste the notes of Santorini’s volcanic soil in every sip. Let stories of grapevines and harvests unfold as the taste of Assyrtiko graces your palate. And just as the day reaches its crescendo, you end the tour at the village of Oia, bathed in golden hues as the sun performs its final act melting into the horizon\n\xa0", 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Costa Marina (Standard) / Santorini Palace (Value) / Majestic (Premium) or similar in Santorini'}, {'day': 7, 'description': '\xa0\n\xa0\nSantorini To Heraklion (Crete)\n\xa0\nTransfers:\n\nToday you will have a shared transfer from the hotel to the Port for the ferry to Heraklion (Crete).\nUpon arrival at Heraklion (Crete) there will be a private transfer from the port to the Hotel.\n\n\xa0\nSpecial Note:\xa0\n\nThe check in at the hotel will be as per the standard hotel time.\xa0\nPost check in the rest of the day will be free at leisure.\n', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Lato Boutique (Standard) / Olive Green (Value) / Galaxy or similar in Heraklion / Crete'}, {'day': 8, 'description': '\xa0\n\xa0\nDay Free At Leisure\xa0\n\xa0\nHeraklio Sightseeing (Optional). Today, the day is yours to spend in order to explore Heraklio (The capital) or experience an optional tour. This city more than lives up to its reputation as being one of the most attractive of the many cities of the Mediterranean! It can satisfy the wishes and demands of a diverse variety of visitors from all over the world, while still providing enjoyment and satisfaction to its permanent residents. It is certainly not a matter of coincidence that it has been the center of Crete for so many centuries, and continues to be so, thanks to an abundance of sightseeing attractions, its joyous way of life, and the legendary hospitality of the Cretan people.', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Lato Boutique (Standard) / Olive Green (Value) / Galaxy or similar in Heraklion / Crete'}, {'day': 9, 'description': '\xa0\n\xa0\nDepart Heraklion\n\xa0\nTransfers: From Heraklion hotel to the Airport in private transfer.\n\xa0\nDo spare a few minutes to share your feedback with our representative or via email as your valued suggestions will be most appreciated. Arrive home with pleasant memories of your overseas tour, which we are sure you will treasure for a lifetime.', 'mealDescription': 'Breakfast', 'overnightStay': 'N/A'}]}, 'hotels': ['\n\n\n\n\xa0 \xa0 \xa0 STANDARD CATEGORY (3* HOTELS OR SIMILAR)\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nAcropolis Ami or Similar\n\n\nElena Hotel or Similar\n\n\nCosta Marina Hotel or similar\n\n\nLato Boutique Hotel or Similar\n\n\n\n', '\n\n\n\nVALUE CATEGORY (4* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nTitania Hotel or similar\n\n\nPetinos Hotel or similar\n\n\nSantorini Palace Hotel or similar\n\n\nOlive Green Hotel or Similar\n\n\n\n', '\n\n\n\nPREMIUM CATEGORY (5* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nRoyal Olympic hotel\nor similar\n\n\nPetinos Beach hotel \nor similar\n\n\nMajestic hotel \nor similar\n\n\nGalaxy\xa0Hotel \nor Similar\n\n\n\n'], 'hotels_list': {'0': '\n\n\n\n\xa0 \xa0 \xa0 STANDARD CATEGORY (3* HOTELS OR SIMILAR)\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nAcropolis Ami or Similar\n\n\nElena Hotel or Similar\n\n\nCosta Marina Hotel or similar\n\n\nLato Boutique Hotel or Similar\n\n\n\n', '1': '\n\n\n\nVALUE CATEGORY (4* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nTitania Hotel or similar\n\n\nPetinos Hotel or similar\n\n\nSantorini Palace Hotel or similar\n\n\nOlive Green Hotel or Similar\n\n\n\n', '2': '\n\n\n\nPREMIUM CATEGORY (5* HOTELS OR SIMILAR)\xa0\n\n\n\n\nAthens\n\n\nMykonos\n\n\nSantorini\n\n\nHeraklion\n\n\n\n\nRoyal Olympic hotel\nor similar\n\n\nPetinos Beach hotel \nor similar\n\n\nMajestic hotel \nor similar\n\n\nGalaxy\xa0Hotel \nor Similar\n\n\n\n'}, 'continents': [{'continentId': 5, 'countryCode': 'GR', 'countryName': 'Greece', 'continentName': 'Europe'}], 'packageTourType': ['Standard', 'Value', 'Premium'], 'packageTourType_details': [