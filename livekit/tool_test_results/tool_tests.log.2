cityName': 'Lucknow', 'cityCode': 'LKO', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Coimbatore', 'cityCode': 'CJB', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Jammu', 'cityCode': 'IXJ', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Thiruvananthapuram', 'cityCode': 'TRV', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Bhubaneswar', 'cityCode': 'BBI', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kochi', 'cityCode': 'COK', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Bhopal', 'cityCode': 'BHO', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Mumbai', 'cityCode': 'BOM', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Kanpur', 'cityCode': 'KNU', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Chandigarh', 'cityCode': 'IXC', 'ltItineraryCode': '', 'holidayLtPricingId': ''}, {'cityName': 'Mangalore', 'cityCode': 'IXE', 'ltItineraryCode': '', 'holidayLtPricingId': ''}], 'packageItinerary': {'summary': "The 'CLASSIC KRABI PHUKET' package is a 6-day tour covering the scenic coastal destinations of Krabi and Phuket. The itinerary includes exciting highlights such as a speedboat excursion to the famous Phi Phi Islands, a four-island tour in Krabi, and a sightseeing tour of Phuket's cultural landmarks, including the Big Buddha and historic Old Town. Participants will also have ample time to relax on pristine beaches, explore vibrant local night markets, and enjoy various water sports along the Andaman Sea.", 'itinerary': [{'day': 1, 'description': '\xa0\n\xa0\nArrive in Phuket and transfer to Krabi (SIC basis)\n\xa0\nTransfers: Upon arriving at the airport, you will be met by our representative and transferred to your hotel in Krabi.\xa0\n(Standard Check in time after 14:00 Hrs.)\n\xa0\nRest of the Day at leisure.\n\xa0\nOvernight in Krabi', 'mealDescription': 'N/A', 'overnightStay': 'Hotel\xa0Apple A Day (Value) /\xa0Centara Ao Nang Resort\xa0(Premium)\xa0or similar in Krabi'}, {'day': 2, 'description': '\xa0\n\xa0\nKrabi 4 Island Tour by Speed Boat with Lunch (SIC basis)\n\xa0\nEnjoy Breakfast at the hotel.\xa0\n\xa0\nEnjoy Krabi’s most popular island-hopping tour by speedboat with lunch included. Visit Phra Nang Beach, Tub Island, Poda Island, and Chicken Island for swimming, snorkeling, scenic walks, limestone cliffs, and relaxing beach time (NPF extra).\n\xa0\nOvernight in Krabi.', 'mealDescription': 'Breakfast and Local Lunch', 'overnightStay': 'Hotel\xa0Apple A Day (Value) /\xa0Centara Ao Nang Resort\xa0(Premium)\xa0or similar in Krabi'}, {'day': 3, 'description': '\xa0\n\xa0\nKrabi to Phuket enroute Phuket City Tour with Dolphin Show (SIC basis)\xa0\n\xa0\nEnjoy Breakfast at the hotel.\xa0\n\xa0\nTransfers: You will be picked up from your hotel in Krabi and transferred to the Phuket Hotel. Enjoy the Phuket City Tour with Dolphin Show on the way.\n\xa0\nKrabi to Phuket enroute Phuket City Tour\nTravel to Phuket and enjoy a guided city tour along the island’s southern coast, covering Patong, Karon, Kata, and Rawai beaches. Stop at Karon Viewpoint for panoramic views and visit the sacred Wat Chalong temple.\n\xa0\nPhuket Dolphin Show\nExperience Phuket’s only dolphinarium at Dolphins Bay, featuring an entertaining dolphin and seal show with impressive tricks and interactions. A fun, family friendly attraction with multiple daily shows (closed Mondays).\n\xa0\nOvernight in Phuket.', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Best Western Patong\xa0(Value) /\xa0The Nature Phuket Resort\xa0(Premium)\xa0or similar in Phuket'}, {'day': 4, 'description': '\xa0\n\xa0\nPhi Phi Island Tour by Speed Boat with Lunch (SIC basis)\xa0\xa0\n\xa0\nEnjoy breakfast at the hotel.\xa0\n\xa0\nPhi Phi Island Tour by Speed Boat with Lunch\nSet out by speedboat to the stunning Phi Phi Islands with lunch included. Discover crystal clear waters, dramatic limestone cliffs, and beautiful bays, with time for swimming, snorkeling, sightseeing, and relaxing on pristine tropical beaches.\n\xa0\nOvernight in Phuket', 'mealDescription': 'Breakfast and Local Lunch', 'overnightStay': 'Hotel\xa0Best Western Patong\xa0(Value) /\xa0The Nature Phuket Resort\xa0(Premium)\xa0or similar in Phuket'}, {'day': 5, 'description': '\xa0\n\xa0\nTiger Kingdom (Medium Tiger) followed by Phuket Fantasea Show with Dinner (SIC basis)\n\xa0\nEnjoy breakfast at the hotel.\n\xa0\nTiger Kingdom (Medium Tiger)\nVisit Tiger Kingdom on a shared basis and experience a thrilling close encounter with medium sized tigers. Capture memorable photos and observe these majestic animals in a well maintained, controlled environment.\n\xa0\nPhuket Fantasea Show with Dinner\nEnjoy the spectacular Phuket Fantasea cultural show on a shared basis, featuring grand stage performances, acrobatics, and special effects, followed by a delicious dinner for a magical evening experience.\n\xa0\nOvernight in Phuket.', 'mealDescription': 'Breakfast and Dinner', 'overnightStay': 'Hotel\xa0Best Western Patong\xa0(Value) /\xa0The Nature Phuket Resort\xa0(Premium)\xa0or similar in Phuket'}, {'day': 6, 'description': '\xa0\n\xa0\nDeparture\n\xa0\nAfter breakfast, you will be transferred to the airport for your return flight.', 'mealDescription': 'Breakfast', 'overnightStay': 'N/A'}]}, 'hotels': ['\n\n\nCity\nHotels or similar\n\n\nKrabi\nRamada by Wyndham Ao Nang (Superior)\xa0or similar in Krabi\n\n\nPhuket\nBel Aire Patong Phuket (Superior)\xa0or similar in Phuket\n\n\n', '\xa0\nValid till Sep 2025\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nRamada by Wyndham Aonang Krabi or similar in Krabi\n\n\nPhuket\nJourneyhub Phuket Patong (Superior City View) or similar in Phuket\n\n\n\n\xa0\nValid from Oct 2025 till Sep 2026\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nDeevana Plaza Krabi (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nBest Western Patong (Superior)\xa0or similar in Phuket\n\n\n', '\n\n\nCity\nHotels or similar\n\n\nKrabi\nAo Nang Phu Pimaan (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nThe Nature Phuket Resort (Deluxe)\xa0or similar in Phuket\n\n\n'], 'hotels_list': {'0': '\n\n\nCity\nHotels or similar\n\n\nKrabi\nRamada by Wyndham Ao Nang (Superior)\xa0or similar in Krabi\n\n\nPhuket\nBel Aire Patong Phuket (Superior)\xa0or similar in Phuket\n\n\n', '1': '\xa0\nValid till Sep 2025\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nRamada by Wyndham Aonang Krabi or similar in Krabi\n\n\nPhuket\nJourneyhub Phuket Patong (Superior City View) or similar in Phuket\n\n\n\n\xa0\nValid from Oct 2025 till Sep 2026\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nDeevana Plaza Krabi (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nBest Western Patong (Superior)\xa0or similar in Phuket\n\n\n', '2': '\n\n\nCity\nHotels or similar\n\n\nKrabi\nAo Nang Phu Pimaan (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nThe Nature Phuket Resort (Deluxe)\xa0or similar in Phuket\n\n\n'}, 'continents': [{'continentId': 1, 'countryCode': 'TH', 'countryName': 'Thailand', 'continentName': 'Asia'}], 'packageTourType': ['Value', 'Premium'], 'packageTourType_details': [{'category': 'Value', 'price': 43300.0, 'hotels': ['\xa0\nValid till Sep 2025\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nRamada by Wyndham Aonang Krabi or similar in Krabi\n\n\nPhuket\nJourneyhub Phuket Patong (Superior City View) or similar in Phuket\n\n\n\n\xa0\nValid from Oct 2025 till Sep 2026\n\n\n\nCity\nHotels or similar\n\n\nKrabi\nDeevana Plaza Krabi (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nBest Western Patong (Superior)\xa0or similar in Phuket\n\n\n']}, {'category': 'Premium', 'price': 55000.0, 'hotels': ['\n\n\nCity\nHotels or similar\n\n\nKrabi\nAo Nang Phu Pimaan (Deluxe)\xa0or similar in Krabi\n\n\nPhuket\nThe Nature Phuket Resort (Deluxe)\xa0or similar in Phuket\n\n\n']}], 'meals': ['\nDaily Breakfast (Except day-1)\n02 Local Lunches\n01 Dinner\n', 'Breakfast Included'], 'visa': ['\nVisa on Arrival - free for Indians Nationals\n'], 'transfer': ['\nAirport / hotel / airport transfers on\xa0SIC\xa0basis\n', '\nAirport / hotel / airport transfers on\xa0SIC basis.\n', '\nAirport / hotel / airport transfers on PVT basis\n'], 'sightseeing': ['\nKrabi 4 Island Tour by Speed Boat with Lunch (NPF Extra) (SIC basis)\nPhuket City Tour with Dolphin Show (Enroute Krabi to Phuket) (SIC basis)\nPhuket Fantasea show with Dinner (SIC basis)\nPhi Phi Island Tour by Speed Boat with Lunch (SIC basis)\nTiger Kingdom (Medium Tiger) (SIC basis)\n', '\nVisit 4 Island Tour on Speedboat with Lunch (SIC Basis)\nVisit Phi Phi Island with Big Boat with lunch (SIC basis)\nKrabi – Phuket enroute Phuket City Tour (SIC basis)\n'], 'tourManagerDescription': '', 'flightDescription': 'Return Economy Class Airfare', 'inclusions': '\n02 nights stay at the selected hotel option or similar in Krabi\n03 nights stay at the selected hotel option or similar in Phuket\nDaily breakfast, except on Day 1\nReturn airport transfers on SIC basis\nKrabi 4 Island Tour by Speed Boat with Lunch (NPF Extra) (SIC basis)\nPhuket City Tour with Dolphin Show (Enroute Krabi to Phuket) (SIC basis)\nPhuket Fantasea show with Dinner (SIC basis)\nPhi Phi Island Tour by Speed Boat with Lunch (SIC basis)\nTiger Kingdom (Medium Tiger) (SIC basis)\nTravel Insurance (Valid for the age group till 60 Yrs.)\xa0\n', 'exclusions': '\nTCS & GST.\nThe rates are valid for a minimum of 01 adult travelling.\nAll flight services.\nPre and post tour services & costs.\nHotel rates are not valid during blackout period / surcharge dates / stop sales.\nMidnight surcharge.\nMeals and beverages that are not mentioned in the itinerary.\nTips for guide & driver.\nCity tax & Tourism Tax (if applicable).\nExpenditure of a personal nature (mini bar, refrigerator use, laundry, telephone calls, etc.)\nCamera fee.\nPorterage facility\nDeparture PCR test, if applicable.\nVisa charges for NRI passengers (if applicable).\nCost of excursions, city sightseeing, entrance fees, and local guides not mentioned in the itinerary.\xa0\nCost of optional excursions.\nAnything that is not mentioned in the Inclusions list.\nBlackout date surcharges:\xa0\nSongkran - 06 Apr - 16 Apr 2026\nPattaya Fireworks Festival, Loy Krathong Festival, Yi Peng Lantern Festival (Chiang Mai) - 20 Nov - 28 Nov 2026.\nChristmas & New Year - 14 Dec 2026 - 05 Jan 2027\nChinese New Year - (ON REQUEST) - 01 Feb - 22 Feb 2027\n', 'termsAndConditions': 'Terms And Conditions:\n\nRates are valid for a minimum of 01 adult travelling.\nHotel upgrade prices are subject to availability at the time of booking.\nHotel upgrade pricing does not guarantee rooms at the preferred / envisaged hotels.\nHotel upgrade rooms remain subject to availability at the time of booking.\nIf the selected upgrade hotel is unavailable, we will provide alternate options for a similar category.\nThe rates are not valid on blackout dates & Trade Fair periods.\xa0\nAny applicable surcharges will be communicated, and passengers will be required to pay them accordingly.\nSurcharges, if applicable, are additional to the total package price quoted at the time of booking.\nGuests are requested to confirm their onward/connecting flights with the sales team before booking.\nAll rates are subject to availability of hotel accommodation and sightseeing at the time of booking.\nWe reserve the right to use an alternate hotel accommodation of an equal or higher standard. If we source a more expensive alternative, we reserve the right to re-quote based on the higher rates.\xa0\nRates are valid for Indian Passport holders only.\xa0\nInternational Check in time is 1400/1500 hours & Check out time is 1100/1200 hours respectively, early check in and checkout is subject to availability and cannot be guaranteed.\xa0\nWherever transfers are included, they are provided without night surcharges.\nNo refunds (partial or full) will be provided for any unutilized services.\nAll sightseeing tours and excursions are operated by local service providers; timings and operating days are subject to change. Changes or Updates, if any, will be shared at the time of booking.\nSightseeing tours are strictly subject to weather conditions, and local service providers reserve the right to cancel tours without prior notice.\nRates are subject to change without prior notice, including for clients travelling during weekends.\nAny promotional offer, if applicable, may be withdrawn at any time without prior notice.\nOnce bookings are confirmed, cancellation charges will apply as per policy and will be informed at that time.\nOrganization is not responsible for any price changes arising from factors beyond our control.\nA refundable security deposit is required at check in as per international hotel policy, payable by credit card or cash; the amount varies by hotel and is returned at check out. Guests should avoid using debit cards since the amount is charged instantly and may take 2–3 weeks to refund. Any additional hotel services (such as mini bar, room service, etc.) may be deducted from this deposit, and Company is not responsible for such transactions, as these are directly between the hotel and the guest.\n', 'pkgSubtypeId': 4, 'pkgSubtypeName': 'FIT', 'pkgTypeId': 1, 'isFlightIncluded': 'Y', 'holidayPlusSubType': 2, 'productId': 11, 'flightsAvailability': 'This package offers optional flights. You can choose to add flights or book separately.', 'serviceSlots': None, 'constructed_thumbnailImage': 'https://resources.thomascook.in/images/holidays/PKG013128/55170_Wat_Tham_Temple_Krabi_Thailand_SRP.jpg', 'constructed_images': ['https://resources.thomascook.in/images/holidays/PKG013128/itinerary/75464_Krabi_Thailand753.jpg', 'https://resources.thomascook.in/images/holidays/PKG013128/itinerary/91271_Railay_beach_Krabi_Thailand753.jpg', 'https://resources.thomascook.in/images/holidays/PKG013128/itinerary/99396_Wat_Chalong_Phuket_Thailand_753.jpg', 'https://resources.thomascook.in/images/holidays/PKG013128/itinerary/8097_Long_Tail_Boat_Phuket_Thailand753.jpg', 'https://resources.thomascook.in/images/holidays/PKG013128/itinerary/248228_James_Bond_Island_Phuket_Thailand753.jpg', 'https://resources.thomascook.in/images/holidays/PKG013128/itinerary/AdobeStock_105110190__PatongBeach,_Phuket.avif']}, 'score': 3.5732946, 'departureCity_details': None, 'fareCalendar': None}, {'id': 'PKG014739', 'itinerary_data': {'packageId': 'PKG014739', 'availableMonths': ['november_2026'], 'packageName': 'Magical Phuket Krabi Bangkok', 'days': 7, 'cities': [{'cityName': 'Phuket', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Phuket', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Krabi', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Krabi', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Bangkok', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Bangkok', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}, {'cityName': 'Bangkok', 'geoLocation': {'lat': 0.0, 'lon': 0.0}}], 'highlights': [''], 'pdfName': 'PKG014739_0_undefined.pdf', 'price': 100364, 'packageSummary': "The 'Magical Phuket Krabi Bangkok' package is a 7-day tour covering the beautiful destinations of Bangkok, Krabi, and Phuket. The itinerary includes exciting activities such as exploring the stunning Phi Phi Islands, embarking on a scenic four-island tour in Krabi, and discovering the rich cultural heritage of Bangkok through guided temple tours. Participants will also enjoy beautiful beachside relaxation, traditional longtail boat rides, and ample opportunities for shopping and tasting local Thai cuisine.", 'images': ['Phuket-Fantasea.jpg', '00139_Phi_Phi_Island_753.jpg', 'Krabi_7531.jpg', 'Krabi.jpg', 'Bangkok7534.jpg', '1209_Golden_buddha_temple_Bangkok_Thailand753.jpg', 'Bangkok1City.jpg'], 'minimumPrice': 100364, 'thumbnailImage': 'Thailand_Phuket.jpg', 'packageTheme': ['Family'], 'isTcilRecomended': 'Recommended', 'packageData': "Package ID: PKG014739 is named 'Magical Phuket Krabi Bangkok' and spans 7 days. The itinerary includes:\nDay 1 - Phuket, Meals: Dinner, Description: Arrival in Phuket - Phuket FantaSea Show Arrive in Phuket and begin your journey on Thailand’s largest and most vibrant island. Later In the evening, visit the spectacular Phuket FantaSea Show, a cultural theme park featuring a vibrant carnival village, shopping, and a grand buffet restaurant. Enjoy the dazzling Las Vegas style performance showcasing Thai mythology, special effects, dancers, fire- eaters, elephants, and more. NOTE All our guests are advised to activate international calling/data & international credit card Joining direct passengers / NRI passengers can check-in on your own at the hotel. The standard check-in time is 1500 hrs. All Guests have to fill up Thai Digital Arrival Card via the below link. https://tdac.immigration.go.th/arrival-card/#/home, GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 2 - Phuket, Meals: Breakfast, Local Lunch and Dinner, Description: Phi Phi Island Tour After breakfast, Embark on an excursion to Phi Phi Islands. Discover locations like Phi Phi Don and Phi Phi Leh, where you can swin and snorkel (at their own expense). Return to Phuket by boat., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 3 - Krabi, Meals: Breakfast and Dinner, Description: City Tour & Dolphin Show - Krabi – Aonang City Tour After breakfast, depart for Phuket’s city highlights—visit the iconic Big Buddha, stroll through the lively Naka Market, and admire the charming Sino-colonial mansions in Phuket Old Town. Later head to an exciting 45colonial mansions in Phuket Old Town. Later head to an exciting 45colonial mansions in Phuket Old Town. Later head to an exciting 45 minutes Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel.minute Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel.minute Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 4 - Krabi, Meals: Breakfast, Local lunch and Dinner, Description: Krabi – Four Island Tour After breakfast, proceed for the Krabi Four Island Tour with local lunch (National Park fees included). This signature excursion takes you by speedboat to some of Krabi’s most renowned landmarks. Guests may enjoy snorkeling in the crystal-clear waters (at their own expense) and capture photographs against the backdrop of the area’s iconic limestone formations. During low tide, experience the unique opportunity to walk across the natural sandbar that links the small islands. Spend the remainder of the day relaxing and taking in Krabi’s stunning coastal views., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 5 - Bangkok, Meals: Breakfast and Dinner, Description: Arrival in Bangkok After breakfast, check out and proceed to the airport for your flight to Bangkok. Upon arrival, transfer to the hotel, stopping en route at Ling Power Duty-Free for shopping. Afterward, continue to your hotel and complete the check-in formalities., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 6 - Bangkok, Meals: Breakfast and Dinner, Description: Marble & Golden Buddha - Free Time for Shopping After breakfast, proceed for a city tour visiting the renowned Marble Temple and Golden Buddha. Later, enjoy free time for shopping at the MBK Shopping Mall., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 7 - Bangkok, Meals: Breakfast, Description: Departure After breakfast, proceed to the airport for your onward flight as your tour comes to an end. Please take a moment to share your feedback with your Tour Manager your suggestions are highly appreciated. Return home with wonderful memories of your journey. Note: Surcharges may be applicable on few of the above departure dates. Please contact your local travel agent for information on Surcharge dates and prices., GeoLocation: (Lat: 0.0, Lon: 0.0).\nThe price is 100364.0. Hotels envisaged include: \n02 nights accommodation Phuket at Deevana plaza Phuket-Patong 4* or similar\n02 nights accommodation Krabi at ibis Styles Krabi Ao Nang 4* or similar\n02 nights accommodation Bangkok at Grand Howard Hotel 4* or similar\n. Meals include: \nDaily breakfast. (Except on the day of arrival)\xa0\n02 Local Lunch at Indian Restaurant\n06 Jain / vegetarian / non-vegetarian Dinners at Indian Restaurant\nNote: Packed meals, if applicable, will be Jain/vegetarian\n\n(B–Breakfast / PB-Packed Breakfast / BR – Brunch / L-Lunch / LL–Local Lunch / LC-Lunch coupon / PL–Packed Lunch / D-Dinner / LD-Local Dinner / PD – Packed Dinner). Inclusions: Return economy class airfare as per the itinerary. Accommodation at the hotels specified above or similar. Visa & Airport taxes (Any further increase in the same must be borne by the guest). Services of a professional & multilingual Tour Manager or Local representative. (Tour Manager subject to minimum 15 customers) A friendly and multilingual Tour Manager accompanies the tour when the group size is 15 or more passengers. For less than 15 passengers, the tour operates on Seat in Coach (SIC)/ Free independent Tour (FIT) basis with a Virtual Tour Manager or local representative providing remote support for daily coordination, briefings, reconfirmations, and assistance. Confirmation of Tour Manager arrangement will be communicated 10-15 days prior to departure. Cost of the ticket taxes for the above itinerary as of 1st February 2026 Medical insurance for the duration of the tour is included in the tour price. However, any passenger above the age of 60 years and those who wish to extend their stay will be required to pay additional charges. Meals, transfers, entrances, sightseeing, and surface transport as mentioned in the itinerary.. Exclusions: The cost of deviation, in case you want to deviate from the group departure dates mentioned in the brochure. City Tax or Tourism tax (If applicable) Visa charges for NRI passengers. (If applicable) Cruise Gratuity (applicable for cruise holidays) Cost of deviation will be advised on confirmation of the deviation date, in case you want to deviate from the group departure dates mentioned in the brochure. The tour cost does not include POE charges, porterage and passport charges. Cost of Basic Travel Quota equivalent to USD 10,000. Govt Taxes & Service taxes as applicable. The cost of airfare included in the above tour cost is based on the fare structure existing as on 1st February 2026. Any further increase in the airfare due to an increase in the fuel price, change in Government regulations, taxes, etc., charged by the airline will have to be borne by the passengers. The company will not be held responsible for the same. Any increase in the rate of exchange leading to an increase in surface transportation and land arrangements which may come into effect prior to departure. The tour price is subject to increase without notice if this rate of exchange changes substantially prior to departure. Any expenses of personal nature such as laundry, wines, mineral water, food and drink not in the regular menus provided by us. Tips to guides, hotel waiters, drivers etc. (If applicable) Meals other than what is mentioned in the itinerary. Cost of excursions, city sightseeing, entrance fees and local guides availed of by the passengers other than those included in your itinerary Visa Requirements Cost Of Visas Including Documentation And Processing Fees As Of 1st February 2026. Any Further Increase In The Same Must Be Borne By The Passengers. Thailand Visa - Free On Arrival Passport Should Be Valid For 6 Months From The Date Of Departure. Product Terms and Conditions: CHILD POLICY Infant Child No Bed Child With Bed 0 - 1.99 yrs 2 - 6.99 yrs 7 - 11.99 yrs. Highlights of the package: .", 'departureCities': [{'cityName': 'Mumbai', 'cityCode': 'BOM', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Delhi', 'cityCode': 'DEL', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Bangalore', 'cityCode': 'BLR', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Kochi', 'cityCode': 'COK', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Chennai', 'cityCode': 'MAA', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Hyderabad', 'cityCode': 'HYD', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Ahmedabad', 'cityCode': 'AMD', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Jaipur', 'cityCode': 'JAI', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Kolkata', 'cityCode': 'CCU', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}, {'cityName': 'Joining Direct', 'cityCode': 'JD', 'ltItineraryCode': 'ZPK550', 'holidayLtPricingId': ''}], 'packageItinerary': {'summary': "The 'Magical Phuket Krabi Bangkok' package is a 7-day tour covering the beautiful destinations of Bangkok, Krabi, and Phuket. The itinerary includes exciting activities such as exploring the stunning Phi Phi Islands, embarking on a scenic four-island tour in Krabi, and discovering the rich cultural heritage of Bangkok through guided temple tours. Participants will also enjoy beautiful beachside relaxation, traditional longtail boat rides, and ample opportunities for shopping and tasting local Thai cuisine.", 'itinerary': [{'day': 1, 'description': '\xa0\nArrival in Phuket - Phuket FantaSea Show\nArrive in Phuket and begin your journey on Thailand’s largest and most vibrant island. Later In the evening, visit the spectacular Phuket FantaSea Show, a cultural theme park featuring a vibrant carnival village, shopping, and a grand buffet restaurant. Enjoy the dazzling Las Vegas style\xa0performance showcasing Thai mythology, special effects, dancers, fire- eaters, elephants, and more.\n\xa0\n\xa0\n\xa0\nNOTE\n\nAll our guests are advised to activate international calling/data & international credit card\nJoining direct passengers / NRI passengers can check-in on your own at the hotel. The standard check-in time is 1500 hrs.\xa0\nAll Guests have to fill up Thai Digital Arrival Card via the below link.\n\nhttps://tdac.immigration.go.th/arrival-card/#/home\xa0\n\n\n', 'mealDescription': 'Dinner', 'overnightStay': 'Hotel\xa0Deevana plaza Phuket-Patong\xa0or similar in Phuket'}, {'day': 2, 'description': '\xa0\n\xa0\nPhi Phi Island Tour\nAfter breakfast, Embark on an excursion to Phi Phi Islands. Discover locations like Phi Phi Don and Phi Phi Leh, where you can swin and snorkel (at their own expense). \xa0Return to Phuket by boat.\xa0', 'mealDescription': 'Breakfast, Local Lunch and Dinner', 'overnightStay': 'Hotel\xa0Deevana plaza Phuket-Patong\xa0or similar in Phuket'}, {'day': 3, 'description': '\xa0\n\xa0\nCity Tour & Dolphin Show - Krabi – Aonang City Tour\nAfter breakfast, depart for Phuket’s city highlights—visit the iconic Big Buddha, stroll through the lively Naka Market, and admire the charming Sino-colonial\xa0mansions in Phuket Old Town. Later head to an exciting 45colonial mansions in Phuket Old Town. Later head to an exciting 45colonial mansions in Phuket Old Town. Later head to an exciting 45 minutes Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel.minute Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel.minute Dolphin Show featuring fun tricks and impressive performances. Continue you journey to Krabi, known for its stunning coral views, dramatic landscapes, and serene atmosphere. En route to your hotel, enjoy a panoramic city tour of Aonang. After the tour, check in and relax at the hotel.', 'mealDescription': 'Breakfast and Dinner', 'overnightStay': 'Hotel Ibis Styles Krabi Ao Nang\xa0or similar in Krabi'}, {'day': 4, 'description': '\xa0\n\xa0\nKrabi – Four Island Tour\nAfter breakfast, proceed for the Krabi Four Island Tour with local lunch (National Park fees included). This signature excursion takes you by speedboat to some of Krabi’s most renowned landmarks. Guests may enjoy snorkeling in the crystal-clear\xa0waters (at their own expense) and capture photographs against the backdrop of the area’s iconic limestone formations. During low tide, experience the unique opportunity to walk across the natural sandbar that links the small islands. Spend the remainder of the day relaxing and taking in Krabi’s stunning coastal views.', 'mealDescription': 'Breakfast, Local lunch and Dinner', 'overnightStay': 'Hotel Ibis Styles Krabi Ao Nang\xa0or similar in Krabi'}, {'day': 5, 'description': '\xa0\n\xa0\nArrival in Bangkok\nAfter breakfast, check out and proceed to the airport for your flight to Bangkok. Upon arrival, transfer to the hotel, stopping en route at Ling Power Duty-Free for shopping. Afterward, continue to your hotel and complete the check-in formalities.', 'mealDescription': 'Breakfast and Dinner', 'overnightStay': 'Hotel Grand Howard or similar in Bangkok'}, {'day': 6, 'description': '\xa0\n\xa0\nMarble & Golden Buddha - Free Time for Shopping\nAfter breakfast, proceed for a city tour visiting the renowned Marble Temple and Golden Buddha. Later, enjoy free time for shopping at the MBK Shopping Mall.', 'mealDescription': 'Breakfast and Dinner', 'overnightStay': 'Hotel Grand Howard or similar in Bangkok'}, {'day': 7, 'description': '\xa0\n\xa0\nDeparture\nAfter breakfast, proceed to the airport for your onward flight as your tour comes to an end. Please take a moment to share your feedback with your Tour Manager your suggestions are highly appreciated. Return home with wonderful memories of your journey.\n\xa0\nNote: Surcharges may be applicable on few of the above departure dates. Please contact your local travel agent for information on Surcharge dates and prices.', 'mealDescription': 'Breakfast', 'overnightStay': 'N/A'}]}, 'hotels': ['\n02 nights accommodation Phuket at Deevana plaza Phuket-Patong 4* or similar\n02 nights accommodation Krabi at ibis Styles Krabi Ao Nang 4* or similar\n02 nights accommodation Bangkok at Grand Howard Hotel 4* or similar\n'], 'hotels_list': {'1': '\n02 nights accommodation Phuket at Deevana plaza Phuket-Patong 4* or similar\n02 nights accommodation Krabi at ibis Styles Krabi Ao Nang 4* or similar\n02 nights accommodation Bangkok at Grand Howard Hotel 4* or similar\n', '0': '\n02 nights accommodation Phuket at Deevana plaza Phuket-Patong 4* or similar\n02 nights accommodation Krabi at ibis Styles Krabi Ao Nang 4* or similar\n02 nights accommodation Bangkok at Grand Howard Hotel 4* or similar\n'}, 'continents': [{'continentId': 1, 'continentName': 'Asia', 'countryCode': 'TH', 'countryName': 'Thailand'}], 'packageTourType': ['Value'], 'packageTourType_details': [{'category': 'Value', 'price': 100400.0, 'hotels': ['\n02 nights accommodation Phuket at Deevana plaza Phuket-Patong 4* or similar\n02 nights accommodation Krabi at ibis Styles Krabi Ao Nang 4* or similar\n02 nights accommodation Bangkok at Grand Howard Hotel 4* or similar\n']}], 'meals': ['\nDaily breakfast. (Except on the day of arrival)\xa0\n02 Local Lunch at Indian Restaurant\n06 Jain / vegetarian / non-vegetarian Dinners at Indian Restaurant\nNote: Packed meals, if applicable, will be Jain/vegetarian\n\n(B–Breakfast / PB-Packed Breakfast / BR – Brunch / L-Lunch / LL–Local Lunch / LC-Lunch coupon / PL–Packed Lunch / D-Dinner / LD-Local Dinner / PD – Packed Dinner)'], 'visa': [], 'transfer': ['\nTransfers as mentioned in the itinerary.\n', '\nAs per itinerary\n'], 'sightseeing': ['Phuket\n\nPhuket Fantasea Show\nPhuket City Tour & Dolphin Show\nPhi Phi Island Tour By Big Boat\xa0\n\nKrabi\n\nEvening City Tour Of Aonang\n4 Island Tour In Krabi With A Local Lunch\n\nBangkok\n\nCity Tour Of Bangkok With Marble Buddha & Golden Buddha\n', '\nPhuket Fantasea Show – Phuket\xa0\nGuided City tour - Phuket\xa0\nDolphin Show -\xa0 Phuket\nGuided city tour of Ao Nang – Krabi\xa0\n4 Island tour with a local lunch – Krabi\xa0\nGuided city tour of Bangkok\xa0\nVisit Marble Buddha & Golden Buddha\n'], 'tourManagerDescription': "<p>Rest assured, Thomas Cook's experienced &amp; knowledgeable tour manager will be with the group at every step of the journey. Be it transportation, accommodation &amp; everything in between, ensuring a seamless &amp; stress-free travel experience from start to finish. Whether it's a question or a challenge, our tour manager is always readily available to offer support, assistance &amp; ensure that your trip becomes a most cherished memory. (Presence of the Tour Manager is subject to a minimum of 15 - 20 customers, depending on package/destination booked)</p>", 'flightDescription': '<ul>\n<li>Return economy class group airfare as per the itinerary.</li>\n<li>Airfare not included for joining direct passengers.</li>\n</ul>', 'inclusions': '\nReturn economy class airfare as per the itinerary.\nAccommodation at the hotels specified above or similar.\nVisa & Airport taxes (Any further increase in the same must be borne by the guest).\nServices of a professional & multilingual Tour Manager or Local representative.\n(Tour Manager subject to minimum 15 customers)\nA friendly and multilingual Tour Manager accompanies the tour when the group size is 15 or more passengers. For less than 15 passengers, the tour operates on Seat in Coach (SIC)/ Free independent Tour (FIT) basis with a Virtual Tour Manager or local representative providing remote support for daily coordination, briefings, reconfirmations, and assistance. Confirmation of Tour Manager arrangement will be communicated 10-15 days prior to departure.\nCost of the ticket taxes for the above itinerary as of 1st February 2026\xa0\nMedical insurance for the duration of the tour is included in the tour price. However, any passenger above the age of 60 years and those who wish to extend their stay will be required to pay additional charges.\nMeals, transfers, entrances, sightseeing, and surface transport as mentioned in the itinerary.\n', 'exclusions': '\nThe cost of deviation, in case you want to deviate from the group departure dates mentioned in the brochure.\nCity Tax or Tourism tax (If applicable)\nVisa charges for NRI passengers. (If applicable)\nCruise Gratuity (applicable for cruise holidays)\nCost of deviation will be advised on confirmation of the deviation date, in case you want to deviate from the group departure dates mentioned in the brochure.\nThe tour cost does not include POE charges, porterage and passport charges.\nCost of Basic Travel Quota equivalent to USD 10,000.\nGovt Taxes & Service taxes as applicable.\nThe cost of airfare included in the above tour cost is based on the fare structure existing as on 1st February 2026. Any further increase in the airfare due to an increase in the fuel price, change in Government regulations, taxes, etc., charged by the airline will have to be borne by the passengers. The company will not be held responsible for the same.\nAny increase in the rate of exchange leading to an increase in surface transportation and land arrangements which may come into effect prior to departure.\nThe tour price is subject to increase without notice if this rate of exchange changes substantially prior to departure.\nAny expenses of personal nature such as laundry, wines, mineral water, food and drink not in the regular menus provided by us.\nTips to guides, hotel waiters, drivers etc. (If applicable)\nMeals other than what is mentioned in the itinerary.\nCost of excursions, city sightseeing, entrance fees and local guides availed of by the passengers other than those included in your itinerary\n\n\xa0\nVisa Requirements\n\xa0\n\nCost Of Visas Including Documentation And Processing Fees As Of 1st February 2026. Any Further Increase In The Same Must Be Borne By The Passengers.\xa0\nThailand Visa - Free On Arrival\nPassport Should Be Valid For 6 Months From The Date Of Departure\n', 'termsAndConditions': '\xa0\n\n\n\n\nCHILD POLICY\n\n\n\n\nInfant\n\n\nChild No Bed\n\n\nChild With Bed\n\n\n\n\n0 - 1.99 yrs\n\n\n2 - 6.99 yrs\n\n\n7 - 11.99 yrs\n\n\n\n', 'pkgSubtypeId': 3, 'pkgSubtypeName': 'GIT', 'pkgTypeId': 1, 'isFlightIncluded': 'Y', 'holidayPlusSubType': -1, 'productId': 4, 'flightsAvailability': 'This package includes flights in the package price.', 'serviceSlots': None, 'constructed_thumbnailImage': 'https://resources.thomascook.in/images/holidays/PKG014739/Thailand_Phuket.jpg', 'constructed_images': ['https://resources.thomascook.in/images/holidays/PKG014739/itinerary/Phuket-Fantasea.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/00139_Phi_Phi_Island_753.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/Krabi_7531.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/Krabi.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/Bangkok7534.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/1209_Golden_buddha_temple_Bangkok_Thailand753.jpg', 'https://resources.thomascook.in/images/holidays/PKG014739/itinerary/Bangkok1City.jpg']}, 'score': 3.5732946, 'departureCity_details': None, 'fareCalendar': None}, {'id': 'PKG015507', 'itinerary_data': {'packageId': 'PKG015507', 'availableMonths': ['november_2026', 'january_2027', 'december_2026', 'october_2026', 'march_2027', 'february_2027'], 'packageName': 'Super Deal Phuket Krabi (5N/6D)', 'days': 6, 'cities': [{'cityName': 'Phuket', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Phuket', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Phuket', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Krabi', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Krabi', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}, {'cityName': 'Krabi', 'geoLocation': {'lon': 0.0, 'lat': 0.0}}], 'highlights': ['One Complimentary Dinner on Arrival'], 'pdfName': None, 'price': 65700, 'packageSummary': "The 'Super Deal Phuket Krabi (5N/6D)' package is a 6-day tour covering the beautiful coastal destinations of Phuket and Krabi. Throughout this tropical getaway, travelers will have the opportunity to explore the scenic beaches and vibrant local attractions of these two famous Thai cities. As a special highlight of the itinerary, participants will be treated to one complimentary dinner on arrival to welcome them to their vacation.", 'images': ['Phuket123.jpg', 'ThailandPhuket.jpg', 'Krabi_753.jpg', 'PhraNangBeach_Krabi_753.jpeg', 'Krabi1.jpg'], 'minimumPrice': 65700, 'thumbnailImage': 'Phuket2.jpg', 'packageTheme': ['Family'], 'isTcilRecomended': 'Recommended', 'packageData': "Package ID: PKG015507 is named 'Super Deal Phuket Krabi (5N/6D)' and spans 6 days. The itinerary includes:\nDay 1 - Phuket, Meals: Dinner, Description: Arrival in Phuket Welcome to Thailand! Upon arriving at the airport, you will be met by our representative and transferred to your hotel in Krabi on a Shared basis (standard time approx.1400 hrs.) Rest of the day at leisure Overnight in Phuket., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 2 - Phuket, Meals: Breakfast and Lunch, Description: Phi Phi Island with Local Lunch by shared Big Boat – SIC basis (National Park fee excluded) Enjoy Breakfast in Hotel. Phi Phi Island with Local Lunch by shared Big Boat Cruise to the stunning Phi Phi Islands on a big boat and enjoy clear waters, scenic beaches, and views of Maya Bay. Visit Monkey Island, swim in vibrant marine life of Maya Bay, relax and enjoy a tasty local lunch. (Entrance to National Park fee is not included) Overnight in Phuket., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 3 - Phuket, Meals: Breakfast, Description: Phuket – Phuket City Tour (Sic Basis) Enjoy breakfast at the hotel. Half day Phuket city tour Discover the charm of Phuket on a guided city tour by shared transfers. Explore iconic temples, vibrant markets, and scenic viewpoints while learning about local culture and history for an unforgettable experience. Overnight in Phuket., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 4 - Krabi, Meals: Breakfast, Description: Phuket - Krabi (SIC Basis) Enjoy breakfast at the hotel. Depart Phuket and enjoy a scenic journey to Krabi, passing through beautiful coastal landscapes and lush tropical countryside. Upon arrival, check in to your hotel and spend the rest of the day at leisure exploring Krabi. Overnight in Krabi., GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 5 - Krabi, Meals: Breakfast and Lunch, Description: Visit Krabi 4 Island Tour by Speed Boat with Picnic Lunch (SIC basis) Enjoy breakfast at the hotel. Krabi 4 Island Tour by Speed Boat with Picnic Lunch Enjoy an exciting Four Islands tour across the stunning Krabi Sea, visiting Phra Nang Cave, Tub Island, Chicken Island, and Poda Island. Swim, snorkel, and relax on pristine white-sand beaches surrounded by crystal-clear waters, vibrant marine life, and swaying coconut palms. (Entrance to National Park fee is not included) Overnight in Krabi, GeoLocation: (Lat: 0.0, Lon: 0.0).\nDay 6 - Krabi, Meals: Breakfast, Description: Krabi Departure After breakfast, you will be transferred to Phuket airport for your return flight., GeoLocation: (Lat: 0.0, Lon: 0.0).\nThe price is 65700.0. Hotels envisaged include: Overnight stay at the Hotels. Meals include: \nDaily breakfast, except on Day 1\nMeals as specified in the itinerary\n. Inclusions: Non-Stop Direct Akasa Air Flights (Ex Mumbai – Return) 03 nights stay at the selected hotel option or similar in Phuket 02 nights stay at the selected hotel option or similar in Krabi Daily breakfast, except on Day 1 Airport / hotel / airport transfers on SIC basis Visit Phi Phi Island by Big Boat with Thai Lunch Excluding NP Fee (SIC Basis) Visit Krabi 4 Island Tour by Speed boat with Picnic lunch Excluding NP Fee (SIC basis) Phuket City Tour (SIC Basis) Travel Insurance (Valid till the age of 60 yrs.). Exclusions: TCS & GST. The rates are valid for a minimum of 01 adult travelling. All flight services. Pre and post tour services & costs. Hotel rates not valid during blackout period / surcharge dates / stop sales. Midnight surcharge. Meals and beverages that are not mentioned in the itinerary. Tips for guide & driver. City tax & Tourism Tax (if applicable). Expenditure of a personal nature (mini bar, refrigerator use, laundry, telephone calls, etc.) Camera fee. Porterage facility Departure PCR test, if applicable. Visa charges for NRI passengers (if applicable). Cost of excursions, city sightseeing, entrance fees, and local guides not mentioned in the itinerary. Cost of optional excursions. Anything that is not mentioned in the Inclusions list.. Product Terms and Conditions: TCS & GST. The rates are valid for a minimum of 01 adult travelling. All flight services. Pre and post tour services & costs. Hotel rates not valid during blackout period / surcharge dates / stop sales. Midnight surcharge. Meals and beverages that are not mentioned in the itinerary. Tips for guide & driver. City tax & Tourism Tax (if applicable). Expenditure of a personal nature (mini bar, refrigerator use, laundry, telephone calls, etc.) Camera fee. Porterage facility Departure PCR test, if applicable. Visa charges for NRI passengers (if applicable). Cost of excursions, city sightseeing, entrance fees, and local guides not mentioned in the itinerary. Cost of optional excursions. Anything that is not mentioned in the Inclusions list.. Highlights of the package: One Complimentary Dinner on Arrival.", 'departureCities': [{'cityName': 'Mumbai', 'cityCode': 'BOM', 'ltItineraryCode': '', 'holidayLtPricingId': ''}], 'packageItinerary': {'summary': "The 'Super Deal Phuket Krabi (5N/6D)' package is a 6-day tour covering the beautiful coastal destinations of Phuket and Krabi. Throughout this tropical getaway, travelers will have the opportunity to explore the scenic beaches and vibrant local attractions of these two famous Thai cities. As a special highlight of the itinerary, participants will be treated to one complimentary dinner on arrival to welcome them to their vacation.", 'itinerary': [{'day': 1, 'description': '\xa0\nArrival in Phuket\xa0\n\xa0\nWelcome to Thailand!\n\xa0\nUpon arriving at the airport, you will be met by our representative and transferred to your hotel in Krabi on a Shared basis (standard time approx.1400 hrs.)\n\xa0Rest of the day at leisure\nOvernight in Phuket.', 'mealDescription': 'Dinner', 'overnightStay': 'Hotel\xa0Best Western\xa0Patong/Amata Patong\xa0 or similar in Phuket'}, {'day': 2, 'description': '\xa0\n\xa0Phi Phi Island with Local Lunch by shared Big Boat – SIC basis (National Park fee excluded)\xa0\n\xa0\nEnjoy Breakfast in Hotel.\n\xa0\nPhi Phi Island with Local Lunch by shared Big Boat\nCruise to the stunning Phi Phi Islands on a big boat and enjoy clear waters, scenic beaches, and views of Maya Bay. Visit Monkey Island, swim in vibrant marine life of Maya Bay, relax and enjoy a tasty local lunch.\n(Entrance to National Park fee is not included)\nOvernight in Phuket.', 'mealDescription': 'Breakfast and Lunch', 'overnightStay': 'Hotel Best Western Patong/Amata Patong\xa0 or similar in Phuket'}, {'day': 3, 'description': '\xa0\nPhuket – Phuket City Tour (Sic Basis)\xa0\nEnjoy breakfast at the hotel.\n\xa0\nHalf day Phuket city tour\xa0\nDiscover the charm of Phuket on a guided city tour by shared transfers. Explore iconic temples, vibrant markets, and scenic viewpoints while learning about local culture and history for an unforgettable experience.\n\xa0\nOvernight in Phuket.', 'mealDescription': 'Breakfast', 'overnightStay': 'Hotel Best Western Patong/Amata Patong\xa0 or similar in Phuket'}, {'day': 4, 'description': '\xa0\nPhuket - Krabi (SIC Basis)\n\xa0\nEnjoy breakfast at the hotel.\n\xa0\nDepart Phuket and enjoy a scenic journey to Krabi, passing through beautiful coastal landscapes and lush tropical countryside. Upon arrival, check in to your hotel and spend the rest of the day at leisure exploring Krabi.\n\xa0\nOvernight in Krabi.', 'mealDescription': 'Breakfast', 'overnightStay': 'Anda Sea Tales\xa0 or similar in Krabi'}, {'day': 5, 'description': '\xa0\nVisit Krabi 4 Island Tour by Speed Boat with Picnic Lunch (SIC basis)\n\xa0\nEnjoy breakfast at the hotel.\n\xa0\nKrabi 4 Island Tour by Speed Boat with Picnic Lunch\nEnjoy an exciting Four Islands tour across the stunning Krabi Sea, visiting Phra Nang Cave, Tub Island, Chicken Island, and Poda Island. Swim, snorkel, and relax on pristine white-sand beaches surrounded by crystal-clear waters, vibrant marine life, and swaying coconut palms.\n(Entrance to National Park fee is not included)\n\xa0\nOvernight in Krabi', 'mealDescription': 'Breakfast and Lunch', 'overnightStay': 'Anda Sea Tales\xa0 or similar in Krabi'}, {'day': 6, 'description': '\xa0\nKrabi Departure\nAfter breakfast, you will be transferred to Phuket airport for your return flight.\n\xa0', 'mealDescription': 'Breakfast', 'overnightStay': 'N/A'}]}, 'hotels': ['Overnight stay at the Hotels'], 'hotels_list': {'1': 'Overnight stay at the Hotels'}, 'continents': [{'continentId': 1, 'countryCode': 'TH', 'countryName': 'Thailand', 'continentName': 'Asia'}]